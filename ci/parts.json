{
  "always": ["strings", "contracts"],
  "all_on": [
    "Directory.Build.props",
    "shared-pin.json",
    "global.json",
    "*.sln",
    ".github/**",
    "**/*.csproj"
  ],
  "code_roots": ["src/", "tests/", "tools/"],
  "parts": {
    "pairing": ["src/*/Pairing/**", "tests/*/Pairing/**", "src/*/SignIn/**", "tests/*/SignIn/**", "src/*/Kiff/**", "tests/*/Kiff/**"],
    "approvals": ["src/*/Approvals/**", "tests/*/Approvals/**", "src/*/NeedsYou/**", "tests/*/NeedsYou/**", "src/*/Kiff/**", "tests/*/Kiff/**",
      "src/*/Coach/CoachApproval*", "tests/*/Coach/CoachApproval*", "src/*/Coach/CoachStart*", "tests/*/Coach/CoachStart*",
      "src/*/Coach/FirstStart*", "tests/*/Coach/PasskeyPair*"],
    "home": ["src/*/Home/**", "tests/*/Home/**", "src/*/Missions/**", "tests/*/Missions/**"],
    "coach": ["src/*/Coach/**", "tests/*/Coach/**"],
    "record": ["src/*/Record/**", "tests/*/Record/**", "src/*/Taf/**", "tests/*/Taf/**"],
    "connections": ["src/*/Connections/**", "tests/*/Connections/**"],
    "calendar": ["src/*/Calendar/**", "tests/*/Calendar/**", "src/*/Usage/**", "tests/*/Usage/**"],
    "account": ["src/*/Account/**", "tests/*/Account/**"],
    "strings": ["src/*/Words/**", "tests/*/Strings/**"],
    "contracts": ["src/*/Contracts/**", "tests/*/Contracts/**"],
    "ci": ["src/*/Ci/**", "tests/*/Ci/**", "tools/**", "ci/**"],
    "app": ["src/Tafs.App/**", "installer/**", ".config/**"]
  }
}
