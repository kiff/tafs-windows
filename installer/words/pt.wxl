<WixLocalization Culture="pt-pt" Language="2070" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Instalação do [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Verificação de atualizações" />
  <String Id="UpdateButton" Value="&amp;Atualizar para a versão [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Boas-vindas" />
  <String Id="InstallMessage" Value="A instalação vai instalar o [WixBundleName] neste PC. Clique em Instalar para continuar ou em Cancelar para sair." />
  <String Id="InstallMessageOptions" Value="A instalação vai instalar o [WixBundleName] neste PC. Clique em Instalar para continuar, em Opções para definir as opções de instalação ou em Cancelar para sair." />
  <String Id="InstallVersion" Value="Versão [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Quer mesmo cancelar?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versão anterior" />
  <String Id="HelpHeader" Value="Ajuda da instalação" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - instala, repara, desinstala ou&#xA;   cria uma cópia local completa do pacote no diretório. Instalar é a opção predefinida.&#xA;&#xA;/passive | /quiet -  mostra uma interface mínima sem perguntas, ou nenhuma interface e&#xA;   nenhuma pergunta. Por predefinição, a interface e todas as perguntas são mostradas.&#xA;&#xA;/norestart   - impede qualquer tentativa de reiniciar. Por predefinição, a interface pergunta antes de reiniciar.&#xA;/log log.txt - escreve o registo num ficheiro específico. Por predefinição, é criado um ficheiro de registo em %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Fechar" />
  <String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Termos de licença&lt;/a&gt; do [WixBundleName]." />
