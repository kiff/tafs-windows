<WixLocalization Culture="es-es" Language="3082" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Instalación de [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Buscando actualizaciones" />
  <String Id="UpdateButton" Value="&amp;Actualizar a la versión [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Le damos la bienvenida" />
  <String Id="InstallMessage" Value="El programa de instalación instalará [WixBundleName] en este PC. Haga clic en Instalar para continuar o en Cancelar para salir." />
  <String Id="InstallMessageOptions" Value="El programa de instalación instalará [WixBundleName] en este PC. Haga clic en Instalar para continuar, en Opciones para elegir las opciones de instalación o en Cancelar para salir." />
  <String Id="InstallVersion" Value="Versión [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="¿Seguro que quiere cancelar?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versión anterior" />
  <String Id="HelpHeader" Value="Ayuda de la instalación" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - instala, repara, desinstala o&#xA;   crea una copia local completa del paquete en el directorio. Instalar es la opción predeterminada.&#xA;&#xA;/passive | /quiet -  muestra una interfaz mínima sin preguntas, o ninguna interfaz y&#xA;   ninguna pregunta. De forma predeterminada se muestran la interfaz y todas las preguntas.&#xA;&#xA;/norestart   - evita cualquier intento de reinicio. De forma predeterminada, la interfaz pregunta antes de reiniciar.&#xA;/log log.txt - escribe el registro en un archivo concreto. De forma predeterminada se crea un archivo de registro en %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Cerrar" />
