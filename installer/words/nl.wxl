  <String Id="InstallMessage" Value="Setup installeert [WixBundleName] op deze pc. Klik op Installeren om door te gaan of op Annuleren om af te sluiten." />
  <String Id="InstallMessageOptions" Value="Setup installeert [WixBundleName] op deze pc. Klik op Installeren om door te gaan, op Opties om installatieopties in te stellen of op Annuleren om af te sluiten." />
