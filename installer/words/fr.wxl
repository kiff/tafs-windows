<WixLocalization Culture="fr-fr" Language="1036" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Installation de [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Recherche de mises à jour" />
  <String Id="UpdateButton" Value="&amp;Mettre à jour vers la version [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Bienvenue" />
  <String Id="InstallMessage" Value="Le programme d'installation va installer [WixBundleName] sur ce PC. Cliquez sur Installer pour continuer, ou sur Annuler pour quitter." />
  <String Id="InstallMessageOptions" Value="Le programme d'installation va installer [WixBundleName] sur ce PC. Cliquez sur Installer pour continuer, sur Options pour définir les options d'installation, ou sur Annuler pour quitter." />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Voulez-vous vraiment annuler ?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Version précédente" />
  <String Id="HelpHeader" Value="Aide de l'installation" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installe, répare, désinstalle ou&#xA;   crée une copie locale complète du package dans le répertoire. L'installation est l'option par défaut.&#xA;&#xA;/passive | /quiet -  affiche une interface minimale sans question, ou aucune interface et&#xA;   aucune question. Par défaut, l'interface et toutes les questions sont affichées.&#xA;&#xA;/norestart   - empêche toute tentative de redémarrage. Par défaut, l'interface demande avant de redémarrer.&#xA;/log log.txt - écrit le journal dans un fichier précis. Par défaut, un fichier journal est créé dans %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Fermer" />
