  <String Id="InstallHeader" Value="Willkommen" />
  <String Id="InstallMessage" Value="Das Setup installiert [WixBundleName] auf diesem PC. Klicken Sie auf „Installieren“, um fortzufahren, oder auf „Abbrechen“, um das Setup zu beenden." />
  <String Id="InstallMessageOptions" Value="Das Setup installiert [WixBundleName] auf diesem PC. Klicken Sie auf „Installieren“, um fortzufahren, auf „Optionen“, um Installationsoptionen festzulegen, oder auf „Abbrechen“, um das Setup zu beenden." />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Möchten Sie den Vorgang wirklich abbrechen?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Vorherige Version" />
  <String Id="HelpHeader" Value="Setup-Hilfe" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installiert, repariert, deinstalliert oder&#xA;   erstellt eine vollständige lokale Kopie des Pakets im Verzeichnis. Standard ist die Installation.&#xA;&#xA;/passive | /quiet -  zeigt eine minimale Oberfläche ohne Rückfragen oder gar keine Oberfläche und&#xA;   keine Rückfragen an. Standardmäßig werden die Oberfläche und alle Rückfragen angezeigt.&#xA;&#xA;/norestart   - unterdrückt jeden Neustartversuch. Standardmäßig fragt die Oberfläche vor einem Neustart.&#xA;/log log.txt - schreibt das Protokoll in eine bestimmte Datei. Standardmäßig wird eine Protokolldatei in %TEMP% erstellt." />
  <String Id="HelpCloseButton" Value="&amp;Schließen" />
  <String Id="InstallLicenseLinkText" Value="[WixBundleName] &lt;a href=&quot;#&quot;&gt;Lizenzbedingungen&lt;/a&gt;." />
