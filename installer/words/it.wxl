<WixLocalization Culture="it-it" Language="1040" xmlns="http://wixtoolset.org/schemas/v4/wxl">
  <String Id="Caption" Value="Installazione di [WixBundleName]" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Ricerca di aggiornamenti" />
  <String Id="UpdateButton" Value="&amp;Aggiorna alla versione [WixStdBAUpdateAvailable]" />
  <String Id="InstallHeader" Value="Benvenuti" />
  <String Id="InstallMessage" Value="Il programma di installazione installerà [WixBundleName] su questo PC. Fare clic su Installa per continuare o su Annulla per uscire." />
  <String Id="InstallMessageOptions" Value="Il programma di installazione installerà [WixBundleName] su questo PC. Fare clic su Installa per continuare, su Opzioni per impostare le opzioni di installazione o su Annulla per uscire." />
  <String Id="InstallVersion" Value="Versione [WixBundleVersion]" />
  <String Id="ConfirmCancelMessage" Value="Annullare l'operazione?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Versione precedente" />
  <String Id="HelpHeader" Value="Guida dell'installazione" />
  <String Id="HelpText" Value="/install | /repair | /uninstall | /layout [directory] - installa, ripristina, disinstalla o&#xA;   crea una copia locale completa del pacchetto nella directory. L'installazione è l'opzione predefinita.&#xA;&#xA;/passive | /quiet -  mostra un'interfaccia minima senza domande, oppure nessuna interfaccia e&#xA;   nessuna domanda. Per impostazione predefinita vengono mostrate l'interfaccia e tutte le domande.&#xA;&#xA;/norestart   - impedisce qualsiasi tentativo di riavvio. Per impostazione predefinita l'interfaccia chiede prima di riavviare.&#xA;/log log.txt - scrive il log in un file specifico. Per impostazione predefinita viene creato un file di log in %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Chiudi" />
  <String Id="InstallLicenseLinkText" Value="&lt;a href=&quot;#&quot;&gt;Condizioni di licenza&lt;/a&gt; di [WixBundleName]." />
