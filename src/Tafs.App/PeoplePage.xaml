<!-- People & groups, as the iPad's PeopleGroupsView: the account's groups, each with its people and the tafs it uses. -->
<Page x:Class="Tafs.App.PeoplePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <local:PageColumn Kind="Reading">
    <StackPanel Margin="24,32" Spacing="12">
      <!-- Back to Account, as the iPad's navigation back. -->
      <Button x:Name="BackButton" Click="OnBack" Style="{StaticResource TafsQuietButton}" FontSize="15" Foreground="{ThemeResource TafsCoach}"
              Padding="0" AutomationProperties.AutomationId="back" />
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
        <!-- A new group, for whoever manages people: words, as the iPad's "+ Group". -->
        <Button x:Name="AddGroup" Grid.Column="1" Click="OnAddGroup" Style="{StaticResource TafsOutlineButton}" VerticalAlignment="Center"
                Visibility="Collapsed" AutomationProperties.AutomationId="people.add-group" />
      </Grid>
      <!-- Why the last change didn't go through, kept over a read again. -->
      <TextBlock x:Name="ChangeError" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
      <TextBlock x:Name="Error" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
      <ProgressRing x:Name="Spinner" IsActive="True" Width="24" Height="24" HorizontalAlignment="Left" />
      <TextBlock x:Name="AccountLine" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" Visibility="Collapsed" />
      <!-- Each group: its name and what it uses, over its people. Drawn in code. -->
      <StackPanel x:Name="Groups" Spacing="16" />
      <TextBlock x:Name="NoGroups" FontSize="14" Foreground="{ThemeResource TafsDim}" Visibility="Collapsed" />
    </StackPanel>
    </local:PageColumn>
  </ScrollViewer>
</Page>
