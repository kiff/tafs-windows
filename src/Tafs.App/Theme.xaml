<!-- The iPad app's palette (Theme.swift), light and dark: a warm cream ground, deep ink, amber for "needs you". -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="TafsBackground" Color="#FBF7EE" />
      <SolidColorBrush x:Key="TafsPanel" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TafsRaised" Color="#F3ECDF" />
      <SolidColorBrush x:Key="TafsInk" Color="#1B1726" />
      <SolidColorBrush x:Key="TafsSoft" Color="#4F4A5E" />
      <SolidColorBrush x:Key="TafsDim" Color="#736D7F" />
      <SolidColorBrush x:Key="TafsLine" Color="#1A1B1726" />
      <SolidColorBrush x:Key="TafsAmberText" Color="#B35500" />
      <SolidColorBrush x:Key="TafsCoach" Color="#2A64F5" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F3ECDF" />
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F3ECDF" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FBF7EE" />
      <!-- Text and marks on an ink fill (Coach's button): white in light, the dark ground in dark. -->
      <SolidColorBrush x:Key="TafsOnFill" Color="#FFFFFF" />
      <!-- Done and refused, as on the iPad (Theme.ok, Theme.no). -->
      <SolidColorBrush x:Key="TafsOk" Color="#198056" />
      <SolidColorBrush x:Key="TafsNo" Color="#DB1F25" />
      <!-- The taf's own words on a held call: the soft colour at 8%. -->
      <SolidColorBrush x:Key="TafsSoftWash" Color="#144F4A5E" />
      <!-- The sidebar's chosen row: a rounded fill of the ink, as the iPad's list draws it, not a side bar. -->
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1F1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#291B1726" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#331B1726" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0F1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1A1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#1B1726" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#1B1726" />
      <!-- The main button is tafs amber with ink text, not Windows' accent colour. -->
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF8A1F" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF9B40" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E87A12" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#1B1726" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1B1726" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1B1726" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="TafsBackground" Color="#141311" />
      <SolidColorBrush x:Key="TafsPanel" Color="#1F1E1B" />
      <SolidColorBrush x:Key="TafsRaised" Color="#2A2824" />
      <SolidColorBrush x:Key="TafsInk" Color="#F2EFE9" />
      <SolidColorBrush x:Key="TafsSoft" Color="#A8A49C" />
      <SolidColorBrush x:Key="TafsDim" Color="#96918A" />
      <SolidColorBrush x:Key="TafsLine" Color="#1FF2EFE9" />
      <SolidColorBrush x:Key="TafsAmberText" Color="#F0A45A" />
      <SolidColorBrush x:Key="TafsCoach" Color="#7FA2FF" />
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#2A2824" />
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#2A2824" />
      <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#141311" />
      <SolidColorBrush x:Key="TafsOnFill" Color="#141311" />
      <SolidColorBrush x:Key="TafsOk" Color="#4CC38A" />
      <SolidColorBrush x:Key="TafsNo" Color="#FF8A73" />
      <SolidColorBrush x:Key="TafsSoftWash" Color="#14A8A49C" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#24F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2EF2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#38F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#12F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#1CF2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#F2EFE9" />
      <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#F2EFE9" />
      <!-- The main button is tafs amber with ink text, not Windows' accent colour. -->
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF8A1F" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF9B40" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#E87A12" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#1B1726" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#1B1726" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#1B1726" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="TafsAmber" Color="#FF8A1F" />
  <!-- A held call's edge (amber at 40%) and its reason's pill (amber at 14%), as on the iPad. -->
  <SolidColorBrush x:Key="TafsAmberEdge" Color="#66FF8A1F" />
  <SolidColorBrush x:Key="TafsAmberWash" Color="#24FF8A1F" />
  <LinearGradientBrush x:Key="TafsBrand" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#B35C00" Offset="0" />
    <GradientStop Color="#E8003A" Offset="0.5" />
    <GradientStop Color="#2A64F5" Offset="1" />
  </LinearGradientBrush>

  <!-- A section's label (the iPad's Eyebrow): monospaced, 12, tracked, in capitals (Sidebar.Eyebrow). -->
  <Style x:Key="TafsEyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CharacterSpacing" Value="58" />
    <Setter Property="Foreground" Value="{ThemeResource TafsDim}" />
  </Style>

  <!-- A sidebar section's label: the eyebrow, lined up with the rows' icons. WinUI's own header draws its
       text in a fixed style, so it gets this template (the pane never folds: PaneDisplayMode Left). -->
  <Style x:Key="TafsSidebarHeader" TargetType="NavigationViewItemHeader">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="NavigationViewItemHeader">
          <TextBlock Margin="16,18,12,6" Text="{TemplateBinding Content}" Style="{StaticResource TafsEyebrow}" TextWrapping="Wrap" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- NEEDS YOU's label, in the amber, as the iPad's Eyebrow(color: Theme.amber). -->
  <Style x:Key="TafsSidebarHeaderAmber" TargetType="NavigationViewItemHeader">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="NavigationViewItemHeader">
          <TextBlock Margin="16,18,12,6" Text="{TemplateBinding Content}" Style="{StaticResource TafsEyebrow}" Foreground="{StaticResource TafsAmber}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Secondary words that follow the theme from code: the soft colour. -->
  <Style x:Key="TafsSoftText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource TafsSoft}" />
  </Style>

  <!-- A line under a section's label, such as Your tafs with none yet: 13, dim. -->
  <Style x:Key="TafsSidebarLine" TargetType="NavigationViewItemHeader">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="NavigationViewItemHeader">
          <TextBlock Margin="16,0,12,6" Text="{TemplateBinding Content}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsDim}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The iPad's outlined button: the ink at 40% around, 15 medium, corners of 14. -->
  <Style x:Key="TafsOutlineButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{ThemeResource TafsLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{ThemeResource TafsInk}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="18,8" />
  </Style>

  <!-- A count at a sidebar row's end (Needs you's): 15 regular in the soft colour, as the iPad's list badge. -->
  <Style x:Key="TafsSidebarCount" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{ThemeResource TafsSoft}" />
  </Style>

  <!-- The Record's chips (the iPad's): 13 in a capsule, on the panel with a line around. Their own template, so pointing
       at the chosen one never washes out its inverted colours. Windows' focus ring still shows. -->
  <Style x:Key="TafsChip" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource TafsPanel}" />
    <Setter Property="BorderBrush" Value="{ThemeResource TafsLine}" />
    <Setter Property="Foreground" Value="{ThemeResource TafsSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <ContentPresenter Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TafsChipChosen" TargetType="Button" BasedOn="{StaticResource TafsChip}">
    <Setter Property="Background" Value="{ThemeResource TafsInk}" />
    <Setter Property="BorderBrush" Value="{ThemeResource TafsInk}" />
    <Setter Property="Foreground" Value="{ThemeResource TafsOnFill}" />
  </Style>

  <!-- A raised row that opens something (the Overview's held calls): the raised colour, corners of 12, padding 12.
       Its own template: pointing at it only dims it a little; Windows' focus ring still shows. -->
  <Style x:Key="TafsRow" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource TafsRaised}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.85" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Opacity" Value="0.7" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter HorizontalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The sidebar's rows: 15 semibold, as the iPad's items, on a rounded fill when chosen. -->
  <Style x:Key="TafsSidebarItem" TargetType="NavigationViewItem">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
</ResourceDictionary>
