<!-- Signed out, the whole window, as the owner's approved mockup (16 Nov) and the iPad's SignInView: Sign in with KIFF on
     the left with Continue, Sign in with your phone on the right with Show the code. A narrow window stacks them. The
     drawings are shapes only, with no word in them (rule 14): every word is a shared key. -->
<Page x:Class="Tafs.App.SignedOutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <Page.Resources>
    <!-- The mockup's amber: white words on it in both themes. -->
    <SolidColorBrush x:Key="GateAmber" Color="#B35500" />
    <Style x:Key="GatePill" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource GateAmber}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="26" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="MinWidth" Value="280" />
      <Setter Property="Padding" Value="32,0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid>
  <Grid.RowDefinitions>
    <RowDefinition Height="*" />
    <RowDefinition Height="Auto" />
  </Grid.RowDefinitions>

  <!-- The welcome's consent (the iPad's OnboardingView, `consent`): one tick for both Terms, each name a link; privacy as two
       links below it, never ticked; the age line. Continue and Show the code wait on the tick. Under both halves. -->
  <Border Grid.Row="1" Background="{ThemeResource TafsRaised}" BorderBrush="{ThemeResource TafsLine}" BorderThickness="0,1,0,0"
          Padding="24,16">
    <StackPanel MaxWidth="760" HorizontalAlignment="Center" Spacing="8">
      <TextBlock x:Name="TermsChanged" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                 Foreground="{ThemeResource TafsAmberText}" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock x:Name="Problem" Visibility="Collapsed" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}"
                 AutomationProperties.LiveSetting="Assertive" />
      <Grid ColumnSpacing="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- The box is its own control, so a link opens its page and never ticks the box. -->
        <CheckBox x:Name="Tick" MinWidth="0" Padding="0" VerticalAlignment="Top" Checked="OnTicked" Unchecked="OnTicked"
                  AutomationProperties.AutomationId="onboarding.tick" />
        <RichTextBlock x:Name="TickWords" Grid.Column="1" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{ThemeResource TafsInk}" />
      </Grid>
      <RichTextBlock x:Name="PrivacyWords" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
      <TextBlock x:Name="AgeLine" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TafsDim}"
                 AutomationProperties.AutomationId="onboarding.age" />
    </StackPanel>
  </Border>

  <Grid x:Name="Halves" SizeChanged="OnSized">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="LeftColumn" Width="*" />
      <ColumnDefinition x:Name="RightColumn" Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TopRow" Height="*" />
      <RowDefinition x:Name="BottomRow" Height="0" />
    </Grid.RowDefinitions>

    <!-- Sign in with KIFF: board 1, a card opening, sparkles round it. -->
    <Grid x:Name="Left" Background="{ThemeResource TafsBackground}">
      <ScrollViewer x:Name="LeftIntro" VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="28" Padding="24,40">
          <!-- Board 1, first run: the owner's approved art for the welcome (Illustrations.FirstRun), at the phone half's width. -->
          <Viewbox Width="300" AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="KiffArt" />
          </Viewbox>
          <TextBlock x:Name="KiffHeading" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
          <Button x:Name="Continue" Click="OnContinue" Style="{StaticResource GatePill}" IsEnabled="False"
                  AutomationProperties.AutomationId="onboarding.continue">
            <Grid>
              <TextBlock x:Name="ContinueWords" />
              <ProgressRing x:Name="ContinueBusy" Width="20" Height="20" IsActive="False" Visibility="Collapsed" Foreground="White" />
            </Grid>
          </Button>
          <!-- Try it with sample data, as the iPad's welcome: tafs with the sample's tafs, calls and Record, signed in as no one. -->
          <Button x:Name="TrySample" Click="OnTrySample" Style="{StaticResource TafsOutlineButton}" HorizontalAlignment="Center"
                  AutomationProperties.AutomationId="onboarding.sample" />
        </StackPanel>
      </ScrollViewer>
      <!-- Continue: KIFF's code, checked in the browser, here in this half. -->
      <Frame x:Name="LeftFrame" Visibility="Collapsed" />
    </Grid>

    <!-- The line between the halves. -->
    <Rectangle x:Name="Divider" Grid.Column="1" Width="1" HorizontalAlignment="Left" Fill="{ThemeResource TafsLine}" />

    <!-- Sign in with your phone: a phone scanning a code. -->
    <Grid x:Name="Right" Grid.Column="1" Background="{ThemeResource TafsRaised}">
      <ScrollViewer x:Name="RightIntro" VerticalScrollBarVisibility="Auto">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="28" Padding="24,40">
          <Viewbox Width="300" Height="300" AutomationProperties.AccessibilityView="Raw">
            <Canvas Width="400" Height="400">
              <Border Canvas.Left="40" Canvas.Top="20" Width="200" Height="350" CornerRadius="34" Background="White"
                      BorderBrush="#1B1726" BorderThickness="5">
                <Canvas>
                  <Rectangle Canvas.Left="66" Canvas.Top="14" Width="58" Height="12" RadiusX="6" RadiusY="6" Fill="#1B1726" />
                  <Rectangle Canvas.Left="20" Canvas.Top="90" Width="150" Height="138" RadiusX="16" RadiusY="16" Stroke="#2A64F5"
                             StrokeThickness="4" StrokeDashArray="3,2" />
                  <Ellipse Canvas.Left="70" Canvas.Top="268" Width="48" Height="48" Fill="#2A64F5" />
                </Canvas>
              </Border>
              <Border Canvas.Left="190" Canvas.Top="70" Width="220" Height="220" CornerRadius="22" Background="White">
                <Canvas x:Name="QrMarks" Margin="18" />
              </Border>
            </Canvas>
          </Viewbox>
          <TextBlock x:Name="PhoneHeading" FontSize="40" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                     Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
          <!-- Windows only: the code waits for this tap, and Windows Hello asks then, never on its own. -->
          <Button x:Name="ShowCode" Click="OnShowCode" Style="{StaticResource GatePill}" IsEnabled="False" AutomationProperties.AutomationId="onboarding.withPhone" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE8B3;" FontSize="18" Foreground="{ThemeResource TafsSoft}" />
            <TextBlock x:Name="ScanLine" FontSize="18" Foreground="{ThemeResource TafsSoft}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <!-- Show the code: Windows Hello once, then the QR and its check code, here in this half. -->
      <Frame x:Name="RightFrame" Visibility="Collapsed" />
    </Grid>
  </Grid>
  </Grid>
</Page>
