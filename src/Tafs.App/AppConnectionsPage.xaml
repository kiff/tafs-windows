<!-- An app's connections, as the iPad's AppConnectionsView: a section per taf, then the removed tafs', then the others;
     each ended with Remove access (or Cancel while its sign-in waits). Drawn in code. -->
<Page x:Class="Tafs.App.AppConnectionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <Grid Padding="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="720" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="12" AutomationProperties.AutomationId="connect.connections">
        <Button x:Name="BackButton" Click="OnBack" Style="{StaticResource TafsQuietButton}" FontSize="15"
                Foreground="{ThemeResource TafsCoach}" Padding="0" />
        <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource TafsInk}"
                   AutomationProperties.HeadingLevel="Level1" />
        <StackPanel x:Name="Body" Spacing="12" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
