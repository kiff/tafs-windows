<!-- Your brief, in Needs you's place once tafs cloud serves one, as the iPad's BriefView: decisions beside Done, the next
     move and the rest under Done. Drawn in code; nothing is signed from here. -->
<Page x:Class="Tafs.App.BriefPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <!-- The window's width, up to 1100, from the left: the two columns share it. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="1100" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Padding="24" Spacing="16" AutomationProperties.AutomationId="brief">
      <StackPanel Spacing="8">
        <TextBlock x:Name="Heading" FontSize="34" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
        <StackPanel x:Name="When" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
          <FontIcon Glyph="&#xE823;" FontSize="13" Foreground="{ThemeResource TafsSoft}" />
          <TextBlock x:Name="WhenText" FontSize="13" Foreground="{ThemeResource TafsSoft}" />
        </StackPanel>
        <ScrollViewer x:Name="LabelRow" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="6" AutomationProperties.AutomationId="brief.labels" />
        </ScrollViewer>
      </StackPanel>

      <!-- Why Later didn't go through, in tafs cloud's words, in red. -->
      <TextBlock x:Name="Error" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />

      <Grid ColumnSpacing="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="Decisions" Spacing="14" />
        <StackPanel x:Name="Side" Grid.Column="1" Spacing="14" />
      </Grid>

      <TextBlock x:Name="Credits" FontSize="12" HorizontalAlignment="Center" Foreground="{ThemeResource TafsDim}" Visibility="Collapsed" />
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
