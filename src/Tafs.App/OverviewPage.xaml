<!-- Overview: today across the tafs, one line each (the iPad's Overview). With no tafs yet, its empty state. -->
<Page x:Class="Tafs.App.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <!-- Up to 720 wide, from the leading edge, as on the iPad. -->
    <Grid Margin="40,32,40,32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="720" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="6">
      <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" />
      <TextBlock x:Name="Subtitle" FontSize="15" Foreground="{ThemeResource TafsSoft}" />

      <Border Margin="0,20,0,0" Background="{ThemeResource TafsPanel}" CornerRadius="14"
              BorderBrush="{ThemeResource TafsLine}" BorderThickness="1" Padding="20,14">
        <StackPanel Spacing="14">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ColumnTaf" Grid.Column="0" Style="{StaticResource TafsEyebrow}" />
            <TextBlock x:Name="ColumnNow" Grid.Column="1" Style="{StaticResource TafsEyebrow}" />
            <TextBlock x:Name="ColumnCard" Grid.Column="2" Style="{StaticResource TafsEyebrow}" />
            <TextBlock x:Name="ColumnLast" Grid.Column="3" Style="{StaticResource TafsEyebrow}" />
          </Grid>
          <Rectangle Height="1" Fill="{ThemeResource TafsLine}" />
          <TextBlock x:Name="Empty" FontSize="15" Foreground="{ThemeResource TafsDim}" Margin="0,8" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="Footnote" FontSize="13" Foreground="{ThemeResource TafsDim}" Margin="0,4,0,0" />
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
