<!-- Overview: today across the tafs, one line each (the iPad's OverviewView). No calendar button: Calendar is in
     the sidebar. With no tafs yet, its empty line. -->
<Page x:Class="Tafs.App.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <!-- Up to 980 wide with its padding of 24, from the leading edge, as on the iPad. -->
    <Grid Padding="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="932" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="20">
      <StackPanel Spacing="4">
        <TextBlock x:Name="Heading" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" />
        <TextBlock x:Name="Subtitle" FontSize="14" Foreground="{ThemeResource TafsDim}" />
        <!-- Board 10, under the title, centred, as the iPad's OverviewView at a regular width (maxWidth: .infinity): shapes only, hidden from Narrator. -->
        <Border x:Name="OverviewArt" HorizontalAlignment="Center" Margin="0,12,0,0" />
      </StackPanel>

      <!-- What waits for the person, above the tafs: one raised row per held call, as on the iPad. -->
      <StackPanel x:Name="NeedsYou" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="NeedsYouLabel" Style="{StaticResource TafsEyebrow}" Foreground="{StaticResource TafsAmber}" />
        <ItemsControl x:Name="Held">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:HeldLine">
              <!-- A row opens its taf's page, where it's answered, as the iPad's and the sidebar's (Needs you when that can't show it). -->
              <Button Click="OnHeld" Tag="{x:Bind Call}" Style="{StaticResource TafsRow}" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource TafsAmber}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             Foreground="{ThemeResource TafsInk}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind AnswerBy}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TafsSoft}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- What else waits (Coach's chats, steps, "Did this happen?"): tafs cloud's count in its words, opening Needs you. -->
        <Button x:Name="Rest" Click="OnHeld" Style="{StaticResource TafsRow}" Visibility="Collapsed"
                AutomationProperties.AutomationId="overview.needsYou">
          <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Fill="{StaticResource TafsAmber}" VerticalAlignment="Center" />
            <TextBlock x:Name="RestWords" Grid.Column="1" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TafsInk}" />
            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TafsSoft}" />
          </Grid>
        </Button>
      </StackPanel>

      <!-- The account's labels, as the iPad's LabelChips: All, two labels, then "+N"; a chip filters the table below. None
           when no taf is labelled. -->
      <ScrollViewer x:Name="LabelRow" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="6" AutomationProperties.AutomationId="labels" />
      </ScrollViewer>

      <!-- One grid, so each heading sits over its column: four equal columns, a line between rows, on the ground. -->
      <Grid x:Name="Table" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ColumnTaf" Grid.Column="0" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="ColumnNow" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="ColumnCard" Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="ColumnLast" Grid.Column="3" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Spacing="12">
          <!-- Board 2, no tafs yet, above the empty table's words, when tafs cloud lists no recipes either. -->
          <Border x:Name="NoTafsArt" HorizontalAlignment="Left" Visibility="Collapsed" />
          <TextBlock x:Name="Empty" FontSize="14" Foreground="{ThemeResource TafsDim}" />
          <!-- The first Home (the iPad's HomeView, docs/onboarding.md), in the empty line's place for someone who may use
               Coach: tafs cloud's line, else the app's; Ask Coach; How tafs works. -->
          <StackPanel x:Name="FirstHome" Visibility="Collapsed" Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
            <Border Style="{StaticResource TafsCard}">
              <StackPanel Spacing="6">
                <TextBlock x:Name="FirstHomeTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TafsInk}" />
                <TextBlock x:Name="FirstHomeLead" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
              </StackPanel>
            </Border>
            <Button x:Name="AskCoach" Style="{StaticResource TafsPrimary}" HorizontalAlignment="Stretch" Click="OnAskCoach"
                    AutomationProperties.AutomationId="home.askCoach" />
            <Button x:Name="HowItWorks" Style="{StaticResource TafsOutlineButton}" HorizontalAlignment="Stretch" Click="OnHowItWorks"
                    AutomationProperties.AutomationId="home.howItWorks" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="Footnote" FontSize="12" Foreground="{ThemeResource TafsDim}" />
      <!-- With no taf, the recipes tafs cloud lists, in place of the empty table, as the iPad's HomeRecipes. -->
      <Frame x:Name="Recipes" Visibility="Collapsed" />
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
