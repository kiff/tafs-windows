<!-- Overview: today across the tafs, one line each (the iPad's OverviewView). No calendar button: Calendar is in
     the sidebar. With no tafs yet, its empty line. -->
<Page x:Class="Tafs.App.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <!-- Up to 980 wide with its padding of 24, from the leading edge, as on the iPad. -->
    <Grid Padding="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MaxWidth="932" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
    <StackPanel Spacing="20">
      <StackPanel Spacing="4">
        <TextBlock x:Name="Heading" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" />
        <TextBlock x:Name="Subtitle" FontSize="14" Foreground="{ThemeResource TafsDim}" />
      </StackPanel>

      <!-- What waits for the person, above the tafs: one raised row per held call, as on the iPad. -->
      <StackPanel x:Name="NeedsYou" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="NeedsYouLabel" Style="{StaticResource TafsEyebrow}" Foreground="{StaticResource TafsAmber}" />
        <ItemsControl x:Name="Held">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:HeldLine">
              <!-- A row opens Needs you, as the sidebar's do (a taf's page, as on the iPad, once there is one). -->
              <Button Click="OnHeld" Style="{StaticResource TafsRow}" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource TafsAmber}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             Foreground="{ThemeResource TafsInk}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind AnswerBy}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TafsSoft}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- The account's labels, as the iPad's LabelChips: All, two labels, then "+N"; a chip filters the table below. None
           when no taf is labelled. -->
      <ScrollViewer x:Name="LabelRow" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
        <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="6" AutomationProperties.AutomationId="labels" />
      </ScrollViewer>

      <!-- One grid, so each heading sits over its column: four equal columns, a line between rows, on the ground. -->
      <Grid x:Name="Table" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ColumnTaf" Grid.Column="0" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="ColumnNow" Grid.Column="1" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="ColumnCard" Grid.Column="2" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="ColumnLast" Grid.Column="3" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="Empty" Grid.Row="1" Grid.ColumnSpan="4" FontSize="14" Foreground="{ThemeResource TafsDim}" />
      </Grid>

      <TextBlock x:Name="Footnote" FontSize="12" Foreground="{ThemeResource TafsDim}" />
      <!-- With no taf, the recipes tafs cloud lists, in place of the empty table, as the iPad's HomeRecipes. -->
      <Frame x:Name="Recipes" Visibility="Collapsed" />
    </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
