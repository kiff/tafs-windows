<!-- Connect apps (the iPad's ConnectAppsView): Yours, then Discover, each a panel holding the table App, How it connects,
     Whose and Status. A connected app has a ✓; the others a Connect as wide as its words. Too narrow for the columns, each
     row is its name over one line and its button, as on a phone. -->
<Page x:Class="Tafs.App.ConnectAppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}" NavigationCacheMode="Required">
  <Page.Resources>
    <!-- A row, and the columns' names, 14 above and below, as the iPad's inset list adds around a 52-high row. -->
    <DataTemplate x:Key="Row" x:DataType="local:ConnectRowView">
      <Grid MinHeight="{x:Bind MinHeight}" BorderBrush="{ThemeResource TafsLine}" BorderThickness="{x:Bind Divider}">
      <!-- Under the column names, a line; narrow, there are none, so no line. -->
      <Border VerticalAlignment="Top" Visibility="{x:Bind UnderHeader}">
        <Border Height="1" Background="{ThemeResource TafsLine}" Visibility="{x:Bind Columns.Table, Mode=OneWay}" />
      </Border>
      <Grid Padding="0,14" ColumnSpacing="12" Visibility="{x:Bind Columns.Table, Mode=OneWay}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{x:Bind Columns.App, Mode=OneWay}" />
          <ColumnDefinition Width="{x:Bind Columns.How, Mode=OneWay}" />
          <ColumnDefinition Width="{x:Bind Columns.Whose, Mode=OneWay}" />
          <ColumnDefinition Width="{x:Bind Columns.Status, Mode=OneWay}" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind HeadApp}" Visibility="{x:Bind IsHeader}" Style="{StaticResource TafsColumnHead}" />
        <TextBlock Grid.Column="1" Text="{x:Bind HeadHow}" Visibility="{x:Bind IsHeader}" Style="{StaticResource TafsColumnHead}" />
        <TextBlock Grid.Column="2" Text="{x:Bind HeadWhose}" Visibility="{x:Bind IsHeader}" Style="{StaticResource TafsColumnHead}" />
        <TextBlock Grid.Column="3" Text="{x:Bind HeadStatus}" Visibility="{x:Bind IsHeader}" Style="{StaticResource TafsColumnHead}" />

        <!-- The logo from tafs cloud only, 24 across, beside the name (the iPad's AsyncImage); none shows no gap. -->
        <Grid ColumnSpacing="10" VerticalAlignment="Center" Visibility="{x:Bind IsApp}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Image Source="{x:Bind Logo}" Width="24" Height="24" Visibility="{x:Bind HasLogo}" AutomationProperties.AccessibilityView="Raw" />
          <StackPanel Grid.Column="1" Spacing="1">
            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Visibility="{x:Bind NameInk}" Foreground="{ThemeResource TafsInk}" />
            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Visibility="{x:Bind NameSoft}" Foreground="{ThemeResource TafsSoft}" />
            <TextBlock Text="{x:Bind Subtitle}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TafsSoft}" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Column="1" Text="{x:Bind How}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TafsSoft}" />
        <TextBlock Grid.Column="2" Text="{x:Bind Whose}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource TafsSoft}" />
        <Grid Grid.Column="3" ColumnSpacing="4" VerticalAlignment="Center" Visibility="{x:Bind IsApp}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Status}" FontSize="14" FontWeight="SemiBold" Visibility="{x:Bind IsConnected}" Foreground="{ThemeResource TafsOk}" />
            <TextBlock Text="{x:Bind Status}" FontSize="14" FontWeight="SemiBold" Visibility="{x:Bind IsReconnect}" Foreground="{ThemeResource TafsAmberText}" />
            <TextBlock Text="{x:Bind UsedBy}" Visibility="{x:Bind HasUsedBy}" FontSize="12" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TafsDim}" />
            <TextBlock Text="{x:Bind Setup}" Visibility="{x:Bind HasSetup}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TafsSoft}" />
          </StackPanel>
          <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="20" Visibility="{x:Bind IsConnected}" Foreground="{ThemeResource TafsOk}"
                    AutomationProperties.Name="{x:Bind Status}" />
          <Button Grid.Column="1" Content="{x:Bind Button}" Visibility="{x:Bind HasButton}" IsEnabled="{x:Bind CanConnect}" Click="OnConnect"
                  Style="{StaticResource TafsOutlineButton}" Padding="16,0" AutomationProperties.Name="{x:Bind ConnectName}" />
          <!-- Its connections, as the iPad's NavigationLink: for a connected app, and one this PC holds a connection to. -->
          <Button Grid.Column="2" Click="OnOpenConnections" Visibility="{x:Bind Opens}" Style="{StaticResource TafsArrow}" Width="32"
                  AutomationProperties.Name="{x:Bind OpensName}" ToolTipService.ToolTip="{x:Bind OpensName}">
            <FontIcon Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource TafsDim}" />
          </Button>
        </Grid>
      </Grid>
      <!-- Narrow (the iPad's compact row): the logo and name with its subtitle, how, whose and where it stands in one line under it, then the
           ✓ or Connect, and its connections. No column names. -->
      <Grid Visibility="{x:Bind Columns.Narrow, Mode=OneWay}">
        <Grid Padding="0,14" ColumnSpacing="10" Visibility="{x:Bind IsApp}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image Source="{x:Bind Logo}" Width="24" Height="24" VerticalAlignment="Center" Visibility="{x:Bind HasLogo}" AutomationProperties.AccessibilityView="Raw" />
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Visibility="{x:Bind NameInk}" Foreground="{ThemeResource TafsInk}" />
            <TextBlock Text="{x:Bind Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Visibility="{x:Bind NameSoft}" Foreground="{ThemeResource TafsSoft}" />
            <TextBlock Text="{x:Bind Subtitle}" FontSize="13" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TafsSoft}" />
            <TextBlock Text="{x:Bind Second}" FontSize="13" TextWrapping="Wrap" Visibility="{x:Bind SecondDim}" Foreground="{ThemeResource TafsDim}" />
            <TextBlock Text="{x:Bind Second}" FontSize="13" TextWrapping="Wrap" Visibility="{x:Bind SecondAmber}" Foreground="{ThemeResource TafsAmberText}" />
          </StackPanel>
          <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="20" VerticalAlignment="Center" Visibility="{x:Bind IsConnected}" Foreground="{ThemeResource TafsOk}"
                    AutomationProperties.Name="{x:Bind Status}" />
          <Button Grid.Column="2" Content="{x:Bind Button}" Visibility="{x:Bind HasButton}" IsEnabled="{x:Bind CanConnect}" Click="OnConnect" VerticalAlignment="Center"
                  Style="{StaticResource TafsOutlineButton}" Padding="16,0" AutomationProperties.Name="{x:Bind ConnectName}" />
          <Button Grid.Column="3" Click="OnOpenConnections" Visibility="{x:Bind Opens}" Style="{StaticResource TafsArrow}" Width="32" VerticalAlignment="Center"
                  AutomationProperties.Name="{x:Bind OpensName}" ToolTipService.ToolTip="{x:Bind OpensName}">
            <FontIcon Glyph="&#xE76C;" FontSize="13" Foreground="{ThemeResource TafsDim}" />
          </Button>
        </Grid>
      </Grid>
      </Grid>
    </DataTemplate>
  </Page.Resources>

  <ScrollViewer>
    <StackPanel Padding="24" Spacing="10" MaxWidth="1100" HorizontalAlignment="Stretch">
      <!-- Back to Account, when opened from it. -->
      <Button x:Name="BackToAccount" Click="OnBackToAccount" Style="{StaticResource TafsQuietButton}" FontSize="15" Foreground="{ThemeResource TafsCoach}"
              Padding="0" Visibility="Collapsed" AutomationProperties.AutomationId="back" />
      <TextBlock x:Name="Heading" FontSize="34" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" />
      <!-- Searched as the person types, as the iPad's .searchable; only with tafs cloud's list. -->
      <!-- 420 across, less in a narrower window. -->
      <Grid x:Name="SearchRow" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="420" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Search" TextChanged="OnSearch" />
      </Grid>
      <TextBlock x:Name="Problem" Visibility="Collapsed" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" />
      <ProgressRing x:Name="Reading" Visibility="Collapsed" IsActive="True" Width="24" Height="24" HorizontalAlignment="Center" Margin="0,24" />

      <TextBlock x:Name="YoursTitle" Style="{StaticResource TafsListHead}" />
      <Border x:Name="YoursPanel" Style="{StaticResource TafsListPanel}" SizeChanged="OnPanelSized">
        <ItemsControl x:Name="Yours" ItemTemplate="{StaticResource Row}" />
      </Border>

      <TextBlock x:Name="DiscoverTitle" Style="{StaticResource TafsListHead}" />
      <Border x:Name="DiscoverPanel" Style="{StaticResource TafsListPanel}" SizeChanged="OnPanelSized">
        <StackPanel>
          <!-- Over Discover only: why Connect waits ("Make one first"), 13 in the dim colour. -->
          <Border x:Name="MakeOne" Style="{StaticResource TafsHourLine}" BorderThickness="0,0,0,1" Padding="0,14">
            <TextBlock x:Name="MakeOneText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsDim}" />
          </Border>
          <ItemsControl x:Name="Discover" ItemTemplate="{StaticResource Row}" />
        </StackPanel>
      </Border>

      <!-- More apps: tafs cloud's next page, as the iPad's list button ("Loading…" meanwhile). -->
      <Border x:Name="MorePanel" Style="{StaticResource TafsListPanel}" Margin="0,10,0,0" Visibility="Collapsed">
        <Button x:Name="More" Click="OnMore" Background="Transparent" BorderThickness="0" Padding="0,14"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="16" Foreground="{StaticResource TafsAmber}" />
      </Border>

      <Border x:Name="AskCoachPanel" Style="{StaticResource TafsListPanel}" Margin="0,10,0,0">
        <Button x:Name="AskCoach" Click="OnAskCoach" Background="Transparent" BorderThickness="0" Padding="0,14"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="16" Foreground="{StaticResource TafsAmber}" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
