<!-- Sign in with KIFF (desktop spec §4): what tafs is, then the code to check in the browser.
     Or add this computer with the phone instead. -->
<Page x:Class="Tafs.App.SignInPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <StackPanel Margin="40,48,40,32" MaxWidth="560" HorizontalAlignment="Left" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Ellipse Width="40" Height="40" Fill="{StaticResource TafsBrand}" />
        <TextBlock x:Name="Heading" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource TafsInk}" />
      </StackPanel>

      <!-- Welcome: a taf inside, outside and after its Card, as on the iPad. -->
      <StackPanel x:Name="Welcome" Spacing="10">
        <TextBlock x:Name="WelcomeLead" FontSize="17" TextWrapping="Wrap" Foreground="{ThemeResource TafsInk}" />
        <Border Background="{ThemeResource TafsPanel}" CornerRadius="14" BorderBrush="{ThemeResource TafsLine}" BorderThickness="1" Padding="20,14">
          <StackPanel Spacing="8">
            <RichTextBlock FontSize="14" Foreground="{ThemeResource TafsSoft}"><Paragraph><Bold><Run x:Name="InsideLead" /></Bold> <Run x:Name="InsideRest" /></Paragraph></RichTextBlock>
            <RichTextBlock FontSize="14" Foreground="{ThemeResource TafsSoft}"><Paragraph><Bold><Run x:Name="OutsideLead" /></Bold> <Run x:Name="OutsideRest" /></Paragraph></RichTextBlock>
            <RichTextBlock FontSize="14" Foreground="{ThemeResource TafsSoft}"><Paragraph><Bold><Run x:Name="RevokedLead" /></Bold> <Run x:Name="RevokedRest" /></Paragraph></RichTextBlock>
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock x:Name="Lead" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />

      <Border x:Name="CodeCard" Background="{ThemeResource TafsPanel}" CornerRadius="14" BorderBrush="{ThemeResource TafsLine}" BorderThickness="1" Padding="20,16">
        <StackPanel Spacing="6">
          <TextBlock x:Name="CodeLabel" Style="{StaticResource TafsEyebrow}" />
          <TextBlock x:Name="Code" FontSize="34" FontWeight="SemiBold" FontFamily="Consolas" CharacterSpacing="160"
                     IsTextSelectionEnabled="True" Foreground="{ThemeResource TafsInk}" />
        </StackPanel>
      </Border>

      <StackPanel x:Name="StatusRow" Orientation="Horizontal" Spacing="10">
        <ProgressRing x:Name="Busy" Width="18" Height="18" IsActive="False" Foreground="{StaticResource TafsAmber}" />
        <TextBlock x:Name="Status" FontSize="15" TextWrapping="Wrap" MaxWidth="520" Foreground="{ThemeResource TafsInk}" />
      </StackPanel>

      <Button x:Name="Primary" Click="OnPrimary" Style="{StaticResource AccentButtonStyle}" Padding="20,8" />

      <StackPanel x:Name="Other" Spacing="2">
        <TextBlock x:Name="OtherBrowser" FontSize="13" Foreground="{ThemeResource TafsDim}" />
        <TextBlock x:Name="Link" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
      </StackPanel>

      <HyperlinkButton x:Name="PairInstead" Click="OnPairInstead" Padding="0" Foreground="{ThemeResource TafsAmberText}" />
      <RichTextBlock x:Name="Agreement" FontSize="12" Foreground="{ThemeResource TafsDim}" Margin="0,8,0,0" />
    </StackPanel>
  </ScrollViewer>
</Page>
