<!-- Account › Devices, as the iPad's DevicesView: each device signed in as this person, when it was last used, and this PC. -->
<Page x:Class="Tafs.App.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <!-- Back to Account, as the iPad's navigation back. -->
      <Button x:Name="BackButton" Click="OnBack" Style="{StaticResource TafsQuietButton}" FontSize="15" Foreground="{ThemeResource TafsCoach}"
              Padding="0" AutomationProperties.AutomationId="back" />
      <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="Error" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
      <ProgressRing x:Name="Spinner" IsActive="True" Width="24" Height="24" HorizontalAlignment="Left" />
      <Border x:Name="Panel" Style="{StaticResource TafsListPanel}" Visibility="Collapsed">
        <StackPanel x:Name="Rows" />
      </Border>
      <!-- The list's footer, as the iPad's: what signing a device out does, and how this PC signs out. -->
      <TextBlock x:Name="NeedsApprover" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" Margin="16,0" Visibility="Collapsed" />
      <TextBlock x:Name="Note" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsDim}" Margin="16,0" />
      <!-- The account's passkeys, as the iPad's: each by its name, a computer's own going with it, Remove for the person's own. -->
      <TextBlock x:Name="PasskeysTitle" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TafsDim}" Margin="16,20,16,0" Visibility="Collapsed"
                 AutomationProperties.HeadingLevel="Level2" />
      <TextBlock x:Name="PasskeysError" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
      <Border x:Name="PasskeysPanel" Style="{StaticResource TafsListPanel}" Visibility="Collapsed">
        <StackPanel x:Name="PasskeyRows" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
