<!-- A halt of one taf or of every taf, as the iPad's HaltScreen: where it stands, who holds it, and one click to halt. -->
<Page x:Class="Tafs.App.HaltPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <local:PageColumn Kind="Reading">
    <StackPanel Margin="24,32" Spacing="16">
      <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
      <!-- Board 4, once every taf reads halted, as the iPad's HaltScreen: shapes only, hidden from Narrator. -->
      <Border x:Name="Art" HorizontalAlignment="Left" Visibility="Collapsed" />

      <Border Style="{StaticResource TafsCard}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="TafName" Style="{StaticResource TafsEyebrow}" />
          <TextBlock x:Name="Headline" FontSize="26" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" />
          <TextBlock x:Name="Explanation" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
        </StackPanel>
      </Border>

      <!-- Once halting: who holds it yet, each part Done or Waiting. -->
      <Border x:Name="Holds" Style="{StaticResource TafsCard}" Visibility="Collapsed">
        <StackPanel x:Name="HoldRows" Spacing="10" />
      </Border>

      <Button x:Name="HaltButton" Style="{StaticResource TafsOutlineNo}" HorizontalAlignment="Left" Click="OnHalt" Visibility="Collapsed" />
      <StackPanel x:Name="Waiting" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
        <ProgressRing IsActive="True" Width="16" Height="16" />
        <TextBlock x:Name="WaitingText" FontSize="14" Foreground="{ThemeResource TafsDim}" VerticalAlignment="Center" />
      </StackPanel>
      <Button x:Name="AgainButton" Style="{StaticResource TafsOutlineNo}" HorizontalAlignment="Left" Click="OnHalt" Visibility="Collapsed" />
      <!-- Resuming gives authority back, so it's signed: until this PC can sign it, the line for an approval made elsewhere. -->
      <Button x:Name="ResumeButton" Style="{StaticResource TafsOutlineButton}" HorizontalAlignment="Left" Click="OnResume" Visibility="Collapsed"
              AutomationProperties.AutomationId="halt.resume" />
      <ContentControl x:Name="ResumeHello" HorizontalContentAlignment="Stretch" Visibility="Collapsed" />
      <TextBlock x:Name="ResumeElsewhere" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" Visibility="Collapsed" />
      <TextBlock x:Name="Error" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
    </StackPanel>
    </local:PageColumn>
  </ScrollViewer>
</Page>
