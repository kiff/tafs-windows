<!-- Needs you (the iPad's NeedsYouView): each held call on its card, or that nothing waits. Until this PC approves
     with Windows Hello, a card's answers are the words that say why, and Add this Windows PC. -->
<Page x:Class="Tafs.App.NeedsYouPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <local:PageColumn Kind="Reading">
    <!-- The iPad's NeedsYouView: padded 16 by 12, its cards across the page's width. -->
    <Grid Padding="16,12">
      <StackPanel Spacing="14">
        <TextBlock x:Name="Heading" FontSize="34" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" />

        <!-- Why the last answer to a step didn't go through, as the iPad's lastError, in red. -->
        <TextBlock x:Name="Error" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />

        <!-- Alerts offered while this account's are off here (the iPad's AlertsCard, as Windows has it): no "even with tafs
             closed", since an alert comes only while tafs runs. Turn on alerts is Account › Alerts' switch. -->
        <Border x:Name="AlertsCard" Visibility="Collapsed" Background="{ThemeResource TafsPanel}" BorderBrush="{ThemeResource TafsLine}"
                BorderThickness="1" CornerRadius="18" Padding="16">
          <StackPanel Spacing="8">
            <TextBlock x:Name="AlertsLead" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource TafsInk}" />
            <TextBlock x:Name="AlertsLine" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
            <Button x:Name="AlertsOn" Click="OnTurnOnAlerts" Style="{StaticResource TafsPrimary}" HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="needsYou.turnOnAlerts" />
            <StackPanel x:Name="AlertsBlocked" Visibility="Collapsed" Spacing="4">
              <TextBlock x:Name="AlertsBlockedText" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" />
              <HyperlinkButton x:Name="AlertsSettings" Click="OnAlertsSettings" Padding="0" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Your step: a step a taf handed its owner, first, as the iPad's. Drawn in code. -->
        <StackPanel x:Name="Steps" Spacing="14" />

        <!-- Coach's chats waiting on the person, after the steps, as the iPad's: Set all aside above them. Drawn in code. -->
        <StackPanel x:Name="CoachWaitingCards" Spacing="14" />

        <!-- Did this happen?: a money call whose outcome KIFF can't prove, before the held calls, as the iPad's. Drawn in code. -->
        <StackPanel x:Name="UnprovenCalls" Spacing="14" />

        <!-- A Card unit's requests, after Did this happen?, as the iPad's CardUnitExceptionPanel. Drawn in code. -->
        <StackPanel x:Name="CardUnitRequests" Spacing="14" />

        <!-- Nothing waiting: the iPad's panel. -->
        <Border x:Name="Empty" Background="{ThemeResource TafsPanel}" BorderBrush="{ThemeResource TafsLine}" BorderThickness="1"
                CornerRadius="18" Padding="16">
          <StackPanel Spacing="12">
            <!-- Board 6, above the words that say it: shapes only (rule 14), hidden from Narrator. -->
            <Border x:Name="EmptyArt" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyLead" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TafsInk}" />
            <TextBlock x:Name="EmptyHint" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
          </StackPanel>
        </Border>

        <ItemsControl x:Name="Calls" ItemTemplate="{StaticResource HeldCallCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- The tafs with a knock at their doors, after the held calls, as the iPad's: each opens its Activity. Drawn in code. -->
        <StackPanel x:Name="KnockedTafs" Spacing="14" />
      </StackPanel>
    </Grid>
    </local:PageColumn>
  </ScrollViewer>
</Page>
