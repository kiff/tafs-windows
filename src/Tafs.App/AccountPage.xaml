<!-- Account (the iPad's SettingsView, as in the reference set's account.png): Your account, Alerts, Theme, Language,
     How it works, Legal, About and Account actions, each a section of the grouped list. Built in code from the rows. -->
<Page x:Class="Tafs.App.AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <local:PageColumn Kind="Reading">
    <StackPanel x:Name="Sections" Padding="24" Spacing="10">
      <Grid>
        <TextBlock x:Name="Heading" FontSize="34" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
        <!-- Close: back to where Account was opened from, as tapping Account again does. -->
        <Button x:Name="CloseButton" Click="OnClose" Style="{StaticResource TafsArrow}" Width="40" Height="40" HorizontalAlignment="Right"
                VerticalAlignment="Center" AutomationProperties.AutomationId="account.close">
          <FontIcon Glyph="&#xE711;" FontSize="14" />
        </Button>
      </Grid>
    </StackPanel>
    </local:PageColumn>
  </ScrollViewer>
</Page>
