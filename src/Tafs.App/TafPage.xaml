<!-- A taf's page (the iPad's TafDetailView), as the reference set's taf.png and taf-setup.png: its avatar, name and state,
     the tabs, the Card bar, its Activity by day, and its Setup. Chat and the Card come in their own changes. -->
<Page x:Class="Tafs.App.TafPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Tafs.App"
      Background="{ThemeResource TafsBackground}">
  <Grid Padding="24,16,24,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The head: the avatar (34, corners of 10, its letter in white), the name (20 bold) and its state's chip. -->
    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="Avatar" Width="34" Height="34" CornerRadius="10" AutomationProperties.AccessibilityView="Raw">
        <TextBlock x:Name="Initial" FontSize="17" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <TextBlock x:Name="NameText" Grid.Column="1" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
      <!-- Working: green on the same green at 15%, in a capsule; Paused, the soft colour the same way. -->
      <Grid x:Name="WorkingChip" Grid.Column="2" VerticalAlignment="Center">
        <Border Background="{ThemeResource TafsOk}" Opacity="0.15" CornerRadius="11" />
        <TextBlock x:Name="StateText" FontSize="12" FontWeight="Medium" Margin="10,4" Foreground="{ThemeResource TafsOk}" />
      </Grid>
      <Grid x:Name="PausedChip" Grid.Column="2" VerticalAlignment="Center" Visibility="Collapsed">
        <Border Background="{ThemeResource TafsSoft}" Opacity="0.15" CornerRadius="11" />
        <TextBlock x:Name="PausedText" FontSize="12" FontWeight="Medium" Margin="10,4" Foreground="{ThemeResource TafsSoft}" />
      </Grid>
    </Grid>

    <!-- Chat, Activity, Card, Setup on the system grey track. -->
    <Border Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource TafsSegmentTrack}">
      <Grid x:Name="Tabs" ColumnSpacing="2" />
    </Border>

    <!-- The Card bar: a small Card in the taf's colour with the Card's mark, what's left of its limit, and its name. -->
    <Border x:Name="CardBar" Grid.Row="2" Margin="0,12,0,0" Background="{ThemeResource TafsPanel}" BorderBrush="{ThemeResource TafsLine}"
            BorderThickness="1" CornerRadius="14" Padding="14,9">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="SmallCard" Width="46" Height="29" CornerRadius="5" AutomationProperties.AccessibilityView="Raw">
          <FontIcon Glyph="&#xE8C7;" FontSize="13" Foreground="#E6FFFFFF" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
          <TextBlock x:Name="CardHero" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"
                     Foreground="{ThemeResource TafsInk}" />
          <TextBlock x:Name="CardUnder" FontSize="12" TextWrapping="Wrap" MaxLines="2" Foreground="{ThemeResource TafsDim}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 12 apart, as margins: a row that's collapsed (the Card bar on Setup) takes no room. -->
    <ScrollViewer Grid.Row="3" Margin="0,12,0,0">
      <Grid Padding="0,4,0,24">
      <!-- Setup: built in code from the taf's job, notes and state. -->
      <StackPanel x:Name="SetupPane" Spacing="16" Visibility="Collapsed" />
      <StackPanel x:Name="ActivityPane" Spacing="10">
        <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="6" />
        <TextBlock x:Name="Empty" FontSize="14" Foreground="{ThemeResource TafsDim}" Margin="0,8,0,0" Visibility="Collapsed" />
        <ItemsControl x:Name="Days">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:TafDayView">
              <StackPanel Spacing="10">
                <!-- "TODAY · NOV 15": 11 medium, monospaced, dim, as the Record's. A next page's day goes on with no title, and none is drawn. -->
                <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind HasTitle}" FontSize="11" FontWeight="Medium"
                           FontFamily="Cascadia Mono, Consolas" Foreground="{ThemeResource TafsDim}" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{x:Bind Lines}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:TafLineView">
                      <Border Background="{ThemeResource TafsPanel}" BorderBrush="{ThemeResource TafsLine}" BorderThickness="1"
                              CornerRadius="14" Padding="14">
                        <Grid ColumnSpacing="12">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <!-- What became of it: green done, approved or started; amber held, sending or unknown; red refused, not done or revoked. -->
                          <Grid VerticalAlignment="Top" Margin="0,6,0,0">
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource TafsOk}" Visibility="{x:Bind IsDone}" />
                            <Ellipse Width="9" Height="9" Fill="{StaticResource TafsAmber}" Visibility="{x:Bind IsWaiting}" />
                            <Ellipse Width="9" Height="9" Fill="{ThemeResource TafsNo}" Visibility="{x:Bind IsRefused}" />
                          </Grid>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TafsInk}" />
                            <TextBlock Text="{x:Bind Detail}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
                          </StackPanel>
                          <!-- Its time, and the money it moved when tafs cloud says. -->
                          <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind Time}" FontSize="12" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TafsDim}" />
                            <TextBlock Text="{x:Bind Amount}" Visibility="{x:Bind HasAmount}" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Foreground="{ThemeResource TafsInk}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- tafs cloud's words under the last line: "Nothing older in this view". -->
        <TextBlock x:Name="EndWords" FontSize="14" Foreground="{ThemeResource TafsDim}" Visibility="Collapsed" />
      </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
