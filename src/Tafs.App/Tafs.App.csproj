<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Tafs.App</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, except the team's MSIX (-p:TafsMsix=true, docs/install.md), unsigned until the signing certificate is decided. -->
    <WindowsPackageType Condition="'$(TafsMsix)' != 'true'">None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Brings the resource (PRI) build tasks, so plain `dotnet build` works with no Visual Studio. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <AssemblyTitle>tafs</AssemblyTitle>
    <!-- Its own Main (Program.cs): one window holds the session, and a second start hands its activation to it. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The mascot as the exe's icon: Start, the taskbar, the title bar and the installer's shortcut show it. -->
    <ApplicationIcon>Assets\tafs.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- The team's MSIX: one package per platform, never signed here. -->
  <PropertyGroup Condition="'$(TafsMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <AppxPackageDir>$(MSBuildThisFileDirectory)..\..\artifacts\msix\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tafs.Core\Tafs.Core.csproj" />
  </ItemGroup>
  <!-- The words, at the pin, beside the app: never copied into the repository. -->
  <ItemGroup>
    <!-- The mascot, from the iPad's asset catalog (ios/Shared/Mascot.xcassets), at 160 px. -->
    <Content Include="Assets\mascot.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same mascot as an icon, 16 to 160 px, made from mascot.png with Windows' high-quality scaling; no text (rule 14). -->
    <Content Include="Assets\tafs.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- The package's logos, made from the mascot. -->
    <Content Include="Assets\Square150x150Logo.png;Assets\Square44x44Logo.png;Assets\StoreLogo.png;Assets\Wide310x150Logo.png" />
    <!-- The words: languages.json and each language's folder. The shared repository's own bookkeeping isn't shipped. -->
    <Content Include="..\..\shared\app\strings\**\*.json" Exclude="..\..\shared\app\strings\*_kept.json;..\..\shared\app\strings\same_as_english.json"
             Link="Strings\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="NeedsTheWords" BeforeTargets="Build" Condition="!Exists('..\..\shared\app\strings\languages.json')">
    <Error Text="The words aren't here. Run: dotnet run --project tools/Tafs.Ci -- sync" />
  </Target>
</Project>
