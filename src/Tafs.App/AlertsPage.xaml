<!-- Account › Alerts, as the iPad's NotificationSettingsView, for this PC's own alerts. -->
<Page x:Class="Tafs.App.AlertsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource TafsBackground}">
  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock x:Name="Heading" FontSize="28" FontWeight="Bold" Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level1" />
      <!-- What an alert looks like, as the iPad's two LockScreenAlerts. Drawn in code. -->
      <StackPanel x:Name="Previews" Spacing="10" />
      <!-- For a KIFF account: alerts on this PC, and their sound. -->
      <Border x:Name="Choices" Style="{StaticResource TafsListPanel}" Visibility="Collapsed">
        <StackPanel>
          <ToggleSwitch x:Name="OnSwitch" Margin="16,8" Toggled="OnToggled" />
          <Border Style="{StaticResource TafsHourLine}" BorderThickness="0,1,0,0">
            <Grid Margin="16,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="SoundTitle" FontSize="15" Foreground="{ThemeResource TafsInk}" />
                <TextBlock x:Name="SoundWords" FontSize="13" Foreground="{ThemeResource TafsDim}" />
              </StackPanel>
              <ToggleSwitch x:Name="SoundSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnSound" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
      <!-- Windows' own setting is off: where to allow it. -->
      <StackPanel x:Name="Blocked" Spacing="4" Visibility="Collapsed">
        <TextBlock x:Name="BlockedText" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" />
        <HyperlinkButton x:Name="OpenSettings" Padding="0" Click="OnOpenSettings" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
