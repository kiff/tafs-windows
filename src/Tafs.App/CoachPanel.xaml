<!-- Coach mode (the iPad's CoachPanel): over what's open, which stays in view, a backdrop that closes it, and the panel
     from the right, a third of the window wide. The panel is on the background, as the iPad's: its bar across the top
     and a 16-wide strip down the left holding the handle, with Coach's wash only under the intro (SetupChatView's). -->
<UserControl x:Class="Tafs.App.CoachPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Over" SizeChanged="OnSized">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition x:Name="PanelColumn" Width="400" />
    </Grid.ColumnDefinitions>
    <!-- The backdrop: black at 12%; a tap on it closes Coach mode. -->
    <Rectangle x:Name="Backdrop" Grid.ColumnSpan="2" Fill="#1F000000" Tapped="OnBackdrop" />

    <!-- What slides: the panel and its shadow. -->
    <Grid x:Name="Panel" Grid.Column="1">
      <Grid.RenderTransform>
        <TranslateTransform x:Name="Slide" />
      </Grid.RenderTransform>
      <!-- The iPad's shadow (black at 18%, radius 24, 4 to the left), as a soft edge. -->
      <Rectangle Width="24" Margin="-24,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#2E000000" Offset="1" />
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid x:Name="Sheet" Background="{ThemeResource TafsBackground}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The left edge's handle, in its own strip: a capsule, the dim at 50%. Dragged, it widens or narrows the panel,
             and past a third it closes it, as the iPad's; the arrow keys do the same from the keyboard. -->
        <Grid x:Name="Handle" Grid.RowSpan="2" Background="Transparent" IsTabStop="True" UseSystemFocusVisuals="True"
              PointerPressed="OnHandlePressed" PointerMoved="OnHandleMoved" PointerReleased="OnHandleReleased"
              PointerCaptureLost="OnHandleLost" PointerEntered="OnHandleEntered" PointerExited="OnHandleExited" KeyDown="OnHandleKey">
          <Rectangle Width="5" Height="44" RadiusX="2.5" RadiusY="2.5" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Fill="{ThemeResource TafsDim}" Opacity="0.5" />
        </Grid>
        <!-- The bar: Full screen and Back on a pill, and the title inline. -->
        <Grid Grid.Column="1" Padding="0,12,16,12">
          <Border Style="{StaticResource TafsToolPill}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="FullScreen" Click="OnFull" Style="{StaticResource TafsArrow}" Width="40">
                <FontIcon x:Name="FullIcon" Glyph="&#xE740;" FontSize="15" Foreground="{ThemeResource TafsCoach}" />
              </Button>
              <Button x:Name="Back" Click="OnBack" Style="{StaticResource TafsArrow}" Width="40">
                <FontIcon Glyph="&#xE76B;" FontSize="16" Foreground="{ThemeResource TafsCoach}" />
              </Button>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{ThemeResource TafsInk}" />
          <!-- New conversation and Coach's conversations, as the iPad's ✎ and ⋯, once Coach is there. -->
          <Border x:Name="ChatTools" Style="{StaticResource TafsToolPill}" HorizontalAlignment="Right" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="NewChat" Click="OnNewChat" Style="{StaticResource TafsArrow}" Width="40">
                <FontIcon Glyph="&#xE70F;" FontSize="15" Foreground="{ThemeResource TafsCoach}" />
              </Button>
              <Button x:Name="MoreChats" Style="{StaticResource TafsArrow}" Width="40">
                <FontIcon Glyph="&#xE712;" FontSize="15" Foreground="{ThemeResource TafsCoach}" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuFlyoutItem x:Name="PreviousChats" Click="OnPreviousChats" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Border>
        </Grid>
        <!-- The intro, on Coach's wash, padded 20 as the iPad's. -->
        <Grid x:Name="Intro" Grid.Row="1" Grid.Column="1" Background="{ThemeResource TafsCoachWash}" Padding="20" RowSpacing="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" VerticalAlignment="Center">
            <TextBlock x:Name="Heading" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource TafsCoach}"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock x:Name="LineText" FontSize="16" TextWrapping="Wrap" Foreground="{ThemeResource TafsSoft}" />
            <!-- On Start's own screen: what's signed, as the iPad's CoachToolsGiven(start: true). Drawn in code. -->
            <StackPanel x:Name="Given" Spacing="10" Visibility="Collapsed" />
            <!-- Why the conversation couldn't be loaded, as the iPad's setupError under its intro. -->
            <TextBlock x:Name="IntroError" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
          </StackPanel>
          </ScrollViewer>
          <!-- Start, as the iPad's introBefore: dimmed with nothing to start Coach with (no session, or one that can't approve). -->
          <Button x:Name="Start" Grid.Row="1" IsEnabled="False" Style="{StaticResource TafsPrimaryOff}" Click="OnStart" />
          <!-- Signed in on a PC that can't approve: why, where Start would be, as the iPad's ApprovalGate. -->
          <TextBlock x:Name="StartGateLine" Grid.Row="1" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                     Foreground="{ThemeResource TafsSoft}" Visibility="Collapsed" />
          <TextBlock x:Name="Footnote" Grid.Row="2" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{ThemeResource TafsDim}" />
        </Grid>
        <!-- Coach's thread, once it has one: drawn in code, as the iPad's SetupChatView.thread. -->
        <Grid x:Name="ThreadView" Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- The plan, pinned above the thread, as the iPad's SetupPlan. -->
          <Border x:Name="PlanHost" Margin="0,8,16,8" Visibility="Collapsed" />
          <ScrollViewer x:Name="ThreadScroll" Grid.Row="1" Padding="0,0,16,16">
            <StackPanel x:Name="ThreadItems" Spacing="12" />
          </ScrollViewer>
          <!-- Why the last message didn't go, or the conversation couldn't be read, as the iPad's setupError over the box. -->
          <TextBlock x:Name="ChatError" Grid.Row="2" Margin="0,0,16,4" FontSize="13" TextWrapping="Wrap"
                     Foreground="{ThemeResource TafsNo}" Visibility="Collapsed" />
          <!-- The composer, as the iPad's: "Ask anything about your tafs", and Send in Coach's colour. Ctrl+Enter sends. -->
          <Grid x:Name="CoachComposer" Grid.Row="3" Margin="0,4,16,12" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CoachDraft" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" KeyDown="OnCoachDraftKey"
                     AutomationProperties.AutomationId="coach.draft" />
            <Button x:Name="CoachSendButton" Grid.Column="1" Style="{StaticResource TafsPrimary}" VerticalAlignment="Bottom" Padding="18,0"
                    Click="OnCoachSend" AutomationProperties.AutomationId="coach.send" />
          </Grid>
        </Grid>
        <!-- Coach's previous conversations, then Archived, as the iPad's SetupChatsList and ArchivedSetupChats: drawn in code. -->
        <Grid x:Name="ChatsView" Grid.Row="1" Grid.Column="1" Visibility="Collapsed" RowSpacing="8" Padding="0,0,16,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Button x:Name="ChatsBack" Click="OnChatsBack" Style="{StaticResource TafsQuietButton}" FontSize="15"
                    Foreground="{ThemeResource TafsCoach}" HorizontalAlignment="Left" />
            <TextBlock x:Name="ChatsTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TafsInk}" AutomationProperties.HeadingLevel="Level2" />
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ChatsItems" Spacing="8" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
