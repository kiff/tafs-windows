<!-- One sidebar for the whole app, as on the iPad (HomeSplitView): the mascot and "tafs" on top, which open
     the Overview; the app's screens; Your tafs; Coach and Account at the foot. The chosen screen opens beside it. -->
<Window x:Class="Tafs.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Tafs.App">
  <Grid x:Name="Root" Background="{ThemeResource TafsBackground}">
    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    OpenPaneLength="300"
                    SelectionChanged="OnSelectionChanged">
      <NavigationView.Resources>
        <!-- The chosen row is a rounded fill (Theme.xaml), as on the iPad: no side marker. -->
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
        <!-- The pane beside the screen, flush, as the iPad's sidebar: no rounded corner or line around the screen. -->
        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
        <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
      </NavigationView.Resources>

      <NavigationView.MenuItems>
        <!-- The mascot and "tafs": the way to the Overview, so there's no Overview item beside it. -->
        <NavigationViewItem x:Name="BrandItem" Style="{StaticResource TafsSidebarItem}" MinHeight="52" Margin="0,8,0,4">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="ms-appx:///Assets/mascot.png" Width="34" Height="34" />
            <TextBlock x:Name="Brand" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Foreground="{ThemeResource TafsInk}" />
          </StackPanel>
        </NavigationViewItem>
        <!-- The app's screens go here (Sidebar.Screens), then Your tafs. -->
        <NavigationViewItemHeader x:Name="YourTafs" Style="{StaticResource TafsSidebarHeader}" />
        <NavigationViewItemHeader x:Name="NoTafs" Style="{StaticResource TafsSidebarLine}" />
      </NavigationView.MenuItems>

      <!-- Coach, then the account just under it: always in sight, never behind a menu. -->
      <NavigationView.PaneFooter>
        <StackPanel Spacing="8" Padding="16,12,16,16">
          <Button x:Name="CoachButton" Click="OnCoach" HorizontalAlignment="Stretch" MinHeight="44" CornerRadius="14"
                  BorderThickness="0" Background="{ThemeResource TafsInk}" Foreground="{ThemeResource TafsOnFill}">
            <Button.Resources>
              <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TafsInk" />
              <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TafsSoft" />
              <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TafsOnFill" />
              <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TafsOnFill" />
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE734;" FontSize="16" />
              <TextBlock x:Name="CoachText" FontSize="15" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
          <Button x:Name="AccountButton" Click="OnAccount" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  MinHeight="44" Padding="4,0" BorderThickness="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <!-- A person in a circle, as the iPad's person.crop.circle in the soft colour; filled amber while Account is open. -->
              <Grid Width="22" Height="22">
                <Grid x:Name="AccountIcon">
                  <Ellipse Stroke="{ThemeResource TafsSoft}" StrokeThickness="1.5" />
                  <FontIcon Glyph="&#xE77B;" FontSize="12" Foreground="{ThemeResource TafsSoft}" />
                </Grid>
                <Grid x:Name="AccountIconChosen" Visibility="Collapsed">
                  <Ellipse Fill="{ThemeResource TafsAmberText}" />
                  <FontIcon Glyph="&#xEA8C;" FontSize="12" Foreground="{ThemeResource TafsOnFill}" />
                </Grid>
              </Grid>
              <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock x:Name="AccountTitle" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TafsInk}" />
                <TextBlock x:Name="AccountName" FontSize="12" Foreground="{ThemeResource TafsDim}" Visibility="Collapsed" />
              </StackPanel>
            </StackPanel>
          </Button>
        </StackPanel>
      </NavigationView.PaneFooter>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- A session with no approval key yet (§4.3): it reads everything and approves nothing. -->
        <InfoBar x:Name="ViewOnly" Severity="Informational" IsClosable="False" Margin="24,20,24,0"
                 Background="{ThemeResource TafsRaised}" Foreground="{ThemeResource TafsInk}">
          <InfoBar.IconSource><FontIconSource Glyph="&#xE7B3;" Foreground="{StaticResource TafsAmber}" /></InfoBar.IconSource>
          <InfoBar.ActionButton>
            <Button x:Name="AddThisDevice" Click="OnAddThisDevice" />
          </InfoBar.ActionButton>
        </InfoBar>
        <Frame x:Name="Pages" Grid.Row="1" />
      </Grid>
    </NavigationView>
    <!-- Coach mode: over everything, the sidebar too, as on the iPad. -->
    <local:CoachPanel x:Name="CoachMode" Visibility="Collapsed" />
  </Grid>
</Window>
